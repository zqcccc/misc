#!/usr/bin/env bash
# qr —— 量化探索台账 CLI（多 agent 并发安全）
#
# 台账是「单例」：所有 worktree / 所有 agent 共用一份，位置解析顺序为
#   1. $QR_HOME
#   2. <主检出目录>/quant_research      （由 git --git-common-dir 推出，跨 worktree 共享）
#   3. 本脚本所在目录                    （主检出还没有该目录时的过渡兜底）
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

resolve_home() {
  if [ -n "${QR_HOME:-}" ]; then echo "$QR_HOME"; return; fi
  local gcd main
  if gcd="$(git rev-parse --git-common-dir 2>/dev/null)"; then
    gcd="$(cd "$gcd" && pwd)"
    main="$(dirname "$gcd")/quant_research"
    if [ -d "$main/hypotheses" ]; then echo "$main"; return; fi
  fi
  echo "$SELF_DIR"
}

HOME_DIR="$(resolve_home)"
HYP="$HOME_DIR/hypotheses"
LOCKS="$HOME_DIR/locks"
TPL="$HOME_DIR/templates/hypothesis.md"
[ -f "$TPL" ] || TPL="$SELF_DIR/templates/hypothesis.md"
TPL_DIR="$(dirname "$TPL")"
REGISTRY="$HOME_DIR/REGISTRY.md"
KNOWLEDGE="$HOME_DIR/KNOWLEDGE.md"
BLOCKERS="$HOME_DIR/blockers"
RUNS="$HOME_DIR/runs"
PROTOCOL_LOG="$HOME_DIR/PROTOCOL_LOG.md"
STALE_HOURS="${QR_STALE_HOURS:-6}"

mkdir -p "$HYP" "$LOCKS" "$BLOCKERS" "$RUNS"
now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }
now_epoch() { date +%s; }
die() { echo "qr: $*" >&2; exit 1; }

agent_name() { echo "${1:-${QR_AGENT:-${CLAUDE_AGENT_NAME:-$(whoami)-$$}}}"; }

hyp_file() {  # $1=ID
  local f
  f="$(ls "$HYP/$1-"*.md 2>/dev/null | head -1 || true)"
  [ -n "$f" ] || die "找不到 $1 的假设卡"
  echo "$f"
}

fm() {  # $1=file $2=key  取 frontmatter 字段
  awk -v k="$2" '
    NR==1 && ($0=="---" || $0=="***") {inf=1; next}
    inf && ($0=="---" || $0=="***" || $0 ~ /^-[-]+$/) {exit}
    inf {
      idx=index($0, ":")
      key=substr($0,1,idx-1); gsub(/\\_/, "_", key)
      if (idx>0 && key==k) { v=substr($0, idx+1); sub(/^[ \t]+/,"",v); gsub(/\\_/, "_", v); print v; exit }
    }' "$1"
}

set_fm() {  # $1=file $2=key $3=value
  local tmp; tmp="$(mktemp)"
  awk -v k="$2" -v v="$3" '
    NR==1 && ($0=="---" || $0=="***") {inf=1; print; next}
    inf && ($0=="---" || $0=="***" || $0 ~ /^-[-]+$/) {inf=0; if(!done) print k ": " v; print; next}
    inf {
      idx=index($0, ":")
      key=substr($0,1,idx-1); gsub(/\\_/, "_", key)
      if (idx>0 && key==k) { print k ": " v; done=1; next }
    }
    {print}' "$1" > "$tmp"
  mv "$tmp" "$1"
  # frontmatter 没闭合时 awk 会静默丢掉这次写入——28 张历史卡就是这么少掉 summary 的
  [ -n "$(fm "$1" "$2")" ] || [ -z "$3" ] || die "写 frontmatter.$2 失败（frontmatter 可能没有闭合的 ---）: $1"
}

# 协议本体（SKILL.md / qbt.py / references）不在台账里，PASS 又完全依赖它，
# 所以每次裁决都把当时的协议指纹钉进卡片，否则「protocol_version: 2」只是一句自称。
resolve_protocol() {
  local d
  for d in "${QBT_HOME:-}" "$(dirname "$HOME_DIR")/.agents/skills/quant-backtest-protocol" \
           "$HOME/.claude/skills/quant-backtest-protocol"; do
    [ -n "$d" ] && [ -f "$d/SKILL.md" ] && { ( cd "$d" && pwd -P ); return; }
  done
  echo ""
}

protocol_digest() {
  local dir; dir="$(resolve_protocol)"
  [ -n "$dir" ] || { echo "unresolved"; return; }
  # 只按「文件名 + 内容」算，排除 __pycache__ 之类的构建产物，保证同一份协议在任何机器上指纹一致
  find "$dir" -type f \( -name '*.md' -o -name '*.py' \) ! -path '*__pycache__*' -print0 \
    | LC_ALL=C sort -z \
    | while IFS= read -r -d '' f; do printf '%s\n' "${f#$dir/}"; cat "$f"; done \
    | shasum -a 256 | cut -c1-16
}

resolve_artifact() {  # 相对路径按台账根解析
  case "$1" in
    /*) echo "$1";;
    *) echo "$HOME_DIR/$1";;
  esac
}

validate_pass_report() {  # $1=report path $2=expected role
  local report; report="$(resolve_artifact "$1")"
  [ -f "$report" ] || die "PASS 报告不存在: $report"
  python3 - "$report" "${2:-alpha}" <<'PY'
import json, sys, math
p, expected_role = sys.argv[1], sys.argv[2]
try:
    obj = json.load(open(p, encoding="utf-8"))
except Exception as exc:
    raise SystemExit(f"qr: PASS 报告无法读取: {exc}")
problems = []
if obj.get("schema_version") != 2:
    problems.append("schema_version 必须为 2")
if obj.get("stage") != "candidate":
    problems.append("stage 必须为 candidate（exploratory 不能 PASS）")
if obj.get("role") != expected_role:
    problems.append(f"role={obj.get('role')!r}，卡片要求 {expected_role!r}")
if obj.get("verdict_code") != "PASS":
    problems.append(f"verdict_code={obj.get('verdict_code')!r}，不是 PASS")
if obj.get("falsification_failures"):
    problems.append("falsification_failures 非空")
# 每个研究角色声称的东西不一样，判读线也不一样：
#   alpha     声称「这个信号有超额」→ 归因、搜索调整、路径、置换
#   execution 声称「同一份敞口换个载体拿更划算」→ 同暴露、净差、压力成本、载体风险
# 拿 alpha 的门禁去判 execution 是错的（它压根不声称有 alpha）。
if expected_role == "execution":
    required_blocks = ("carrier_swap", "carrier_swap_stressed", "carrier_risk",
                       "execution_check", "data_provenance")
    gate_fields = (
        ("carrier_swap", "net_diff_annual", False), ("carrier_swap", "net_diff_t", False),
        ("carrier_swap", "exposure_adjusted_excess_annual", False),
        ("carrier_swap", "exposure_adjusted_t", False),
        ("carrier_swap", "beta_vs_incumbent", False), ("carrier_swap", "r_squared", True),
        ("carrier_swap_stressed", "net_diff_annual", False),
    )
else:
    required_blocks = ("execution_check", "data_provenance", "window_consistency")
    gate_fields = (
        ("alpha_beta", "ann_alpha", False), ("alpha_beta", "alpha_t", False),
        ("monte_carlo", "prob_profit", True), ("random_portfolio", "percentile_vs_random", True),
        ("selection_adjustment", "DSR" if "DSR" in obj.get("selection_adjustment", {}) else "PSR", True),
    )
for key in required_blocks:
    val = obj.get(key)
    if not isinstance(val, dict) or val.get("error"):
        problems.append(f"{key} 缺失或失败")
for section, field, probability in gate_fields:
    block = obj.get(section)
    value = block.get(field) if isinstance(block, dict) else None
    try:
        valid = (not isinstance(value, bool) and isinstance(value, (int, float))
                 and math.isfinite(value) and (not probability or 0 <= value <= 1))
    except (TypeError, ValueError, OverflowError):
        valid = False
    if not valid:
        problems.append(f"{section}.{field} 缺失或不是合法有限统计值")
if problems:
    raise SystemExit("qr: PASS 报告未通过门禁: " + "；".join(problems))
PY
}

CAUSES="无机理 信号无增量 方向反了 成本吃穿 不可成交 样本外翻转 强度不足 尾部不可接受 容量不足 数据不可得 溢价已死 未来函数 幸存者偏差 参数拟合"

# KNOWLEDGE.md 是每轮每个 agent 都要全文读的东西，它必须能扫。
# 所以结论句禁止行话——指标名和数值留在假设卡 §7，这里只放人话。
JARGON="alpha DSR PSR NW IC Sharpe 夏普 分位 t= t值 p= p值 beta β 置换 自助 显著性 分块"

check_plain_language() {  # $1=结论句
  local w hits=""
  for w in $JARGON; do
    case "$1" in *"$w"*) hits="$hits $w";; esac
  done
  [ -z "$hits" ] || die "结论句里不许出现行话：${hits# }
它会原样进 KNOWLEDGE.md，而那是每个 agent 每轮都要读的东西。
指标和数值写进假设卡 §7，这里只写人话。
反例：「净 alpha +2.9%（NW t=0.35），β=1.007」
正例：「剥掉大盘涨跌后基本什么都不剩——它就是把整个池子买了一遍」"
}

cmd_knowledge() {
  local f id mark
  {
    printf '# 已固化结论（读完再开工）\n\n'
    printf '每行 = 红绿灯 · 市场 · 做了什么 · 死在哪一环 · 一句人话。**数值和判读表在各自的假设卡 §7**。\n\n'
    for f in $(ls "$HYP"/*.md 2>/dev/null | sort); do
      [ "$(fm "$f" status)" = "done" ] || continue
      id="$(fm "$f" id)"
      case "$(fm "$f" verdict)" in PASS) mark="🟢";; PARK) mark="🟡";; FAIL) mark="🔴";; *) continue;; esac
      printf -- '- %s [%s] %s —— %s —— %s（%s）\n' \
        "$mark" "$(fm "$f" market)" "$(short_topic "$(fm "$f" title)")" \
        "$(fm "$f" cause)" "$(plain_of "$f")" "$id"
    done
  } > "$KNOWLEDGE"
  echo "已重建 ${KNOWLEDGE#$HOME_DIR/}"
}

plain_of() {  # 人话结论优先，历史卡没有就退回原 summary
  local v; v="$(fm "$1" plain)"
  [ -n "$v" ] || v="$(fm "$1" summary)"
  echo "$v"
}

# 台账行只留能扫的部分：完整假设句在卡片和 REGISTRY 里
short_topic() {
  python3 -c '
import sys
t = sys.argv[1]
LIMIT = 44
cut = None
# 优先在自然断句处截，但截完太短就没信息量了，退回按长度截
for sep in ("，", "：", "；", ","):
    i = t.find(sep)
    if 12 <= i <= LIMIT:
        cut = i; break
short = t if (cut is None and len(t) <= LIMIT) else t[:cut if cut is not None else LIMIT]
# 别留下半个括号
for lo, hi in (("（", "）"), ("(", ")")):
    if short.count(lo) > short.count(hi):
        short = short[:short.rfind(lo)]
short = short.rstrip("、/+-（( ")
print(short + ("" if short == t else "…"))
' "$1"
}

# 只保留 ASCII，避免不同 locale 下多字节文件名踩坑；中文标题落在 frontmatter 里，不进文件名
slugify() {
  echo "$1" | LC_ALL=C tr '[:upper:]' '[:lower:]' \
    | LC_ALL=C sed -e 's/[^a-z0-9]\{1,\}/-/g' -e 's/^-//' -e 's/-$//' \
    | cut -c1-48
}

# ---------- search：去重闸 ----------
cmd_search() {
  [ $# -ge 1 ] || die "用法: qr search <关键词> [更多关键词...]"
  local hit=0 kw f
  for kw in "$@"; do
    echo "── 关键词「${kw}」"
    local found=0
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      found=1; hit=1
      printf '   %s  [%s/%s]  %s\n' "$(fm "$f" id)" "$(fm "$f" status)" "$(fm "$f" verdict)" "$(fm "$f" title)"
      printf '      %s\n' "${f#$HOME_DIR/}"
    done < <(grep -ril -- "$kw" "$HYP" 2>/dev/null | sort)
    if [ -f "$KNOWLEDGE" ] && grep -i -q -- "$kw" "$KNOWLEDGE" 2>/dev/null; then
      found=1; hit=1
      echo "   KNOWLEDGE.md 命中："
      grep -i -- "$kw" "$KNOWLEDGE" | sed 's/^/      /'
    fi
    [ "$found" = 1 ] || echo "   （无命中）"
  done
  if [ "$hit" = 1 ]; then
    echo
    echo "⚠️  有命中。逐条读完命中的假设卡，确认你的想法与它们【机理不同或数据/口径不同】后才可 claim；"
    echo "    否则不要重复探索——直接在原卡上追加 note，或换方向。"
    return 1
  fi
  echo
  echo "✅ 无命中，可以 claim。"
}

# ---------- claim ----------
cmd_claim() {
  local title="" tags="" market="multi" family="other" agent="" srcs="" slug_opt="" freq="d1" role="alpha" parent="" score=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --tags) tags="$2"; shift 2;;
      --market) market="$2"; shift 2;;
      --family) family="$2"; shift 2;;
      --agent) agent="$2"; shift 2;;
      --source) srcs="$srcs$2 "; shift 2;;
      --slug) slug_opt="$(slugify "$2")"; shift 2;;
      --freq) freq="$2"; shift 2;;
      --role) role="$2"; shift 2;;
      --parent) parent="$2"; shift 2;;
      --score) score="$2"; shift 2;;
      -*) die "未知参数 $1";;
      *) title="$1"; shift;;
    esac
  done
  [ -n "$title" ] || die '用法: qr claim "<一句话假设>" --family <家族> --market <市场> --tags a,b --agent <名字>'
  case "$role" in alpha|diversifier|hedge|execution) ;; *) die "--role 只能是 alpha/diversifier/hedge/execution";; esac
  if [ -n "$parent" ]; then
    case "$parent" in H[0-9][0-9][0-9][0-9]) ;; *) die "--parent 必须是 Hxxxx 形式";; esac
    ls "$HYP/$parent-"*.md >/dev/null 2>&1 || die "--parent $parent 没有对应的假设卡"
  fi
  agent="$(agent_name "$agent")"

  # 号段分配：mkdir 的原子性保证两个 agent 同时 claim 也拿不到同一个号。
  # 额外校验假设卡是否已存在——防止 locks/ 目录在 git 传递中丢失后号段被重复分配。
  local n=1 id
  while :; do
    id="$(printf 'H%04d' "$n")"
    if mkdir "$LOCKS/$id" 2>/dev/null; then
      if ls "$HYP/$id-"*.md >/dev/null 2>&1; then n=$((n+1)); continue; fi
      : > "$LOCKS/$id/.gitkeep"   # 号段登记要能进 git，空目录 git 不跟踪
      break
    fi
    n=$((n+1))
  done

  local slug file
  slug="${slug_opt:-$(slugify "$title")}"
  [ -n "$slug" ] || slug="$family"
  file="$HYP/$id-$slug.md"

  sed -e "s/{{ID}}/$id/g" -e "s/{{SLUG}}/$slug/g" -e "s/{{TITLE}}/$(echo "$title" | sed 's/[&/\]/\\&/g')/g" \
      -e "s/{{MARKET}}/$market/g" -e "s/{{FAMILY}}/$family/g" -e "s/{{TAGS}}/$tags/g" \
      -e "s/{{FREQ}}/$freq/g" -e "s/{{OWNER}}/$agent/g" -e "s/{{ROLE}}/$role/g" \
      -e "s/{{PARENT}}/$parent/g" -e "s/{{TS}}/$(now_iso)/g" "$TPL" > "$file"
  [ -z "$srcs" ] || set_fm "$file" sources "$srcs"
  [ -z "$score" ] || set_fm "$file" score "$score"

  printf 'agent=%s\nclaimed_at=%s\nclaimed_epoch=%s\nfile=%s\ntitle=%s\n' \
    "$agent" "$(now_iso)" "$(now_epoch)" "${file#$HOME_DIR/}" "$title" > "$LOCKS/$id/owner"

  cmd_index >/dev/null
  echo "$id  已占坑 → ${file#$HOME_DIR/}"
  echo "把机理、数据需求、先验检索结论先写进这张卡，再动手写代码。"
}

# ---------- note ----------
cmd_note() {
  [ $# -ge 2 ] || die '用法: qr note <ID> "<进展一句话>"'
  local id="$1"; shift
  local file; file="$(hyp_file "$id")"
  # note 允许非坑主写（接管前留痕就是这么用的），但要在日志里标出来是外人写的
  local own me; own="$(owner_of "$id")"; me="$(agent_name "${QR_AGENT:-}")"
  if [ -n "$own" ] && [ "$own" != "$me" ] && explicit_agent; then
    printf -- '- `%s` %s（非坑主，坑主是 %s）：%s\n' "$(now_iso)" "$me" "$own" "$*" >> "$file"
  else
    printf -- '- `%s` %s：%s\n' "$(now_iso)" "$me" "$*" >> "$file"
  fi
  set_fm "$file" updated_at "$(now_iso)"
  [ "$(fm "$file" status)" = "claimed" ] && set_fm "$file" status "running" || true
  cmd_index >/dev/null
  echo "$id 已记录。"
}

# ---------- verdict ----------
cmd_verdict() {
  [ $# -ge 3 ] || die '用法: qr verdict <ID> <PASS|FAIL|PARK> "<一句话结论，带数>"'
  local id="$1" v="$2"; shift 2
  case "$v" in PASS|FAIL|PARK) ;; *) die "裁决只能是 PASS / FAIL / PARK";; esac
  local report="" summary="" cause="" arg
  while [ $# -gt 0 ]; do
    case "$1" in
      --report) [ $# -ge 2 ] || die "--report 缺路径"; report="$2"; shift 2;;
      --cause) [ $# -ge 2 ] || die "--cause 缺值"; cause="$2"; shift 2;;
      *) arg="$1"; summary="${summary}${summary:+ }${arg}"; shift;;
    esac
  done
  [ -n "$summary" ] || die "裁决必须有一句话结论"
  if [ "$v" != "PASS" ]; then
    [ -n "$cause" ] || die "FAIL/PARK 必须写清死在哪一环：--cause <$(echo $CAUSES | tr ' ' '|')>"
    case " $CAUSES " in *" $cause "*) ;; *) die "--cause 只能是：$CAUSES";; esac
  fi
  check_plain_language "$summary"
  local file; file="$(hyp_file "$id")"
  require_owner "$id" "裁决"
  if [ "$v" = "PASS" ]; then
    [ -n "$report" ] || die "PASS 必须提供 --report verified/<ID>/verdict.json"
    local role; role="$(fm "$file" research_role)"; role="${role:-alpha}"
    case "$role" in
      alpha) ;;
      execution) ;;   # 走 qbt.py carrier 的载体替换验收，判读线见 SKILL.md
      *) die "$role 角色还没有验收路径：diversifier/hedge 需要各自的专用报告（组合增量 / 对冲有效性），
现在没有，不能 PASS。alpha 用 qbt.py report，execution 用 qbt.py carrier。";;
    esac
    validate_pass_report "$report" "$role"
  fi
  set_fm "$file" status "done"
  set_fm "$file" verdict "$v"
  set_fm "$file" protocol_sha256 "$(protocol_digest)"
  set_fm "$file" summary "$summary"
  set_fm "$file" plain "$summary"
  [ -z "$cause" ] || set_fm "$file" cause "$cause"
  [ -z "$report" ] || set_fm "$file" report "$report"
  set_fm "$file" updated_at "$(now_iso)"
  printf -- '- `%s` %s：**裁决 %s** —— %s\n' "$(now_iso)" "$(agent_name "${QR_AGENT:-}")" "$v" "$summary" >> "$file"
  cmd_knowledge >/dev/null
  rm -f "$LOCKS/$id/owner"
  cmd_index >/dev/null
  echo "$id 裁决 ${v}，已释放锁并写入 KNOWLEDGE.md。"
}

# ---------- release ----------
cmd_release() {
  [ $# -ge 1 ] || die '用法: qr release <ID> ["放弃原因"]'
  local id="$1"; shift || true
  local file; file="$(hyp_file "$id")"
  require_owner "$id" "释放"
  set_fm "$file" status "abandoned"
  set_fm "$file" updated_at "$(now_iso)"
  printf -- '- `%s` %s：放弃占坑 —— %s\n' "$(now_iso)" "$(agent_name "${QR_AGENT:-}")" "${*:-未说明}" >> "$file"
  rm -f "$LOCKS/$id/owner"
  cmd_index >/dev/null
  echo "$id 已释放（状态 abandoned，卡片保留，供后人查重）。"
}

# ---------- list / stale / index ----------
cmd_list() {
  local want="${1:-}" f
  printf '%-7s %-10s %-8s %-10s %-14s %s\n' ID STATUS VERDICT MARKET OWNER TITLE
  for f in "$HYP"/*.md; do
    [ -e "$f" ] || continue
    local st; st="$(fm "$f" status)"
    [ -z "$want" ] || [ "$st" = "$want" ] || [ "$(fm "$f" verdict)" = "$want" ] || continue
    printf '%-7s %-10s %-8s %-10s %-14s %s\n' \
      "$(fm "$f" id)" "$st" "$(fm "$f" verdict)" "$(fm "$f" market)" "$(fm "$f" owner)" "$(fm "$f" title)"
  done
}

cmd_stale() {
  local hours="${1:-$STALE_HOURS}" now d
  now="$(now_epoch)"
  echo "超过 ${hours}h 未更新的活跃占坑："
  local any=0
  for d in "$LOCKS"/*/; do
    [ -f "$d/owner" ] || continue
    local ep age id
    ep="$(sed -n 's/^claimed_epoch=//p' "$d/owner")"
    id="$(basename "$d")"
    local file; file="$(ls "$HYP/$id-"*.md 2>/dev/null | head -1 || true)"
    if [ -n "$file" ]; then
      local mt
      mt="$(stat -f %m "$file" 2>/dev/null || stat -c %Y "$file")"
      [ "$mt" -gt "${ep:-0}" ] && ep="$mt"
    fi
    age=$(( (now - ${ep:-0}) / 3600 ))
    if [ "$age" -ge "$hours" ]; then
      any=1
      printf '  %s  %sh  agent=%s  %s\n' "$id" "$age" "$(sed -n 's/^agent=//p' "$d/owner")" "$(sed -n 's/^title=//p' "$d/owner")"
    fi
  done
  [ "$any" = 1 ] || echo "  （无）"
}

cmd_index() {
  {
    echo "# 探索台账索引"
    echo
    echo "> 本文件由 \`./qr index\` 自动生成，不要手改。真身在 \`hypotheses/\`。"
    echo
    echo "| ID | 状态 | 裁决 | 市场 | 家族 | 标题 | 负责人 | 更新 |"
    echo "|---|---|---|---|---|---|---|---|"
    local f
    for f in "$HYP"/*.md; do
      [ -e "$f" ] || continue
      printf '| [%s](%s) | %s | %s | %s | %s | %s | %s | %s |\n' \
        "$(fm "$f" id)" "hypotheses/$(basename "$f")" "$(fm "$f" status)" "$(fm "$f" verdict)" \
        "$(fm "$f" market)" "$(fm "$f" family)" "$(fm "$f" title)" "$(fm "$f" owner)" "$(fm "$f" updated_at)"
    done
  } > "$REGISTRY"
  echo "已重建 ${REGISTRY#$HOME_DIR/}"
}

# ---------- audit：检查台账结构与 PASS 机器门禁 ----------
cmd_audit() {
  local errors=0 warnings=0 legacy=0 noscreen=0 total=0 f key section value report output
  for f in "$HYP"/*.md; do
    [ -e "$f" ] || continue
    total=$((total+1))
    case "$(head -1 "$f")" in
      ---) ;;
      *) echo "WARN  ${f#$HOME_DIR/}: 非标准 YAML 分隔符（应为 ---）"; warnings=$((warnings+1));;
    esac
    if ! awk 'NR==1 && ($0=="---" || $0=="***"){inf=1; next}
               inf && ($0=="---" || $0=="***" || $0 ~ /^-[-]+$/){found=1; exit}
               inf && $0 !~ /^[A-Za-z_\\][A-Za-z0-9_\\]*:/ && $0 != "" {exit}
               END{exit !found}' "$f"; then
      echo "ERROR ${f#$HOME_DIR/}: frontmatter 没有闭合的 ---（后续 set_fm 会静默丢字段）"
      errors=$((errors+1))
    fi
    for key in id title status verdict market family owner; do
      value="$(fm "$f" "$key")"
      if [ -z "$value" ]; then
        echo "ERROR ${f#$HOME_DIR/}: 缺 frontmatter.$key"
        errors=$((errors+1))
      fi
    done
    if [ -z "$(fm "$f" protocol_version)" ]; then
      legacy=$((legacy+1))
    fi
    if [ "$(fm "$f" status)" = "done" ] && [ -z "$(fm "$f" screen_verdict)" ]; then
      noscreen=$((noscreen+1))
    fi
    value="$(fm "$f" research_role)"
    if [ -n "$value" ]; then
      case "$value" in
        alpha|diversifier|hedge|execution) ;;
        *) echo "ERROR ${f#$HOME_DIR/}: research_role=$value 不是 alpha/diversifier/hedge/execution"; errors=$((errors+1));;
      esac
    fi
    value="$(fm "$f" parent)"
    if [ -n "$value" ] && ! ls "$HYP/$value-"*.md >/dev/null 2>&1; then
      echo "ERROR ${f#$HOME_DIR/}: parent=$value 没有对应的假设卡"
      errors=$((errors+1))
    fi
    for section in 1 2 3 4 5 6 7 8 9; do
      if ! grep -q "^## ${section}\." "$f"; then
        echo "ERROR ${f#$HOME_DIR/}: 缺第 ${section} 节"
        errors=$((errors+1))
      fi
    done
    if [ "$(fm "$f" status)" = "done" ] && [ "$(fm "$f" verdict)" = "OPEN" ]; then
      echo "ERROR ${f#$HOME_DIR/}: status=done 但 verdict=OPEN"
      errors=$((errors+1))
    fi
    if [ "$(fm "$f" verdict)" = "PASS" ]; then
      report="$(fm "$f" report)"
      if [ -z "$report" ]; then
        echo "ERROR ${f#$HOME_DIR/}: PASS 没有 report"
        errors=$((errors+1))
      else
        value="$(fm "$f" protocol_sha256)"
        if [ -z "$value" ] || [ "$value" = "unresolved" ]; then
          echo "ERROR ${f#$HOME_DIR/}: PASS 没有可用的 protocol_sha256（无法确定按哪一版协议判的）"
          errors=$((errors+1))
        fi
        value="$(fm "$f" research_role)"; value="${value:-alpha}"
        if ! output="$(validate_pass_report "$report" "$value" 2>&1)"; then
          echo "ERROR ${f#$HOME_DIR/}: $output"
          errors=$((errors+1))
        fi
      fi
    fi
  done
  echo "audit: cards=$total errors=$errors warnings=$warnings legacy_v1=$legacy 未过成本闸=$noscreen"
  [ "$errors" -eq 0 ]
}


# ---------- coverage：覆盖盘点，告诉你地图上哪里还是白的 ----------
MARKET_AXIS="cn_stock hk_stock us_stock crypto_spot crypto_perp fx futures commodity rates multi"
FAMILY_AXIS="reversal momentum lowvol value quality size carry microstructure flow event seasonality ml portfolio timing"

cmd_coverage() {
  local tmp; tmp="$(mktemp)"
  local f
  for f in "$HYP"/*.md; do
    [ -e "$f" ] || continue
    printf '%s\t%s\t%s\t%s\n' "$(fm "$f" market)" "$(fm "$f" family)" "$(fm "$f" verdict)" "$(fm "$f" freq)" >> "$tmp"
  done

  echo "== 市场 × 机理族 覆盖 =="
  local m fam n verds hit_any=0
  local blank_markets="" 
  for m in $MARKET_AXIS; do
    local line="" explored=0 blanks=""
    for fam in $FAMILY_AXIS; do
      n="$(awk -F'\t' -v m="$m" -v c="$fam" '$1==m && $2==c {k++} END{print k+0}' "$tmp")"
      if [ "$n" -gt 0 ]; then
        verds="$(awk -F'\t' -v m="$m" -v c="$fam" '$1==m && $2==c {printf "%s,", $3}' "$tmp" | sed 's/,$//')"
        line="$line  $fam:$n($verds)"
        explored=$((explored+1))
      else
        blanks="$blanks $fam"
      fi
    done
    if [ "$explored" -gt 0 ]; then
      hit_any=1
      printf '%-12s%s\n' "$m" "$line"
      printf '%-12s空白: %s\n' "" "$(echo "$blanks" | cut -c1-200)"
    else
      blank_markets="$blank_markets $m"
    fi
  done
  [ "$hit_any" = 1 ] || echo "（台账还是空的，整张地图都可以撒点）"

  echo
  echo "== 零覆盖的市场（优先撒点）=="
  echo " ${blank_markets:- （无，每个市场都至少有一张卡）}"

  echo
  echo "== 零覆盖的机理族（跨全部市场）=="
  local zero=""
  for fam in $FAMILY_AXIS; do
    n="$(awk -F'\t' -v c="$fam" '$2==c {k++} END{print k+0}' "$tmp")"
    [ "$n" -gt 0 ] || zero="$zero $fam"
  done
  echo " ${zero:- （无）}"

  echo
  echo "== 时间颗粒度分布 =="
  awk -F'\t' '{k[$4 == "" ? "(未标注)" : $4]++} END{for(x in k) printf "  %-12s %s\n", x, k[x]}' "$tmp"
  [ -s "$tmp" ] || echo "  （无数据）"
  rm -f "$tmp"

  echo
  echo "提示：开放式探索时，候选池必须往上面「零覆盖」的格子里撒点，不要全堆在已探过的市场。"
}

