# 死掉的课题里最值钱的往往不是裁决，而是顺手挖到的线索。
# 以前这些线索只有出口没有入口——写进卡里就没人再看。这个命令把它们拉回候选池。
cmd_leads() {
  python3 - "$HYP" <<'LEADSPY'
import glob, os, re, sys
hyp = sys.argv[1]
files = sorted(glob.glob(os.path.join(hyp, "*.md")))

def fm(text, key):
    m = re.search(r"^%s:[ \t]*(.*)$" % key, text, re.M)
    return (m.group(1).strip() if m else "")

# 已经被子卡接手的线索不再提示
taken = {fm(open(f, encoding="utf-8").read(), "parent") for f in files}
# 只认「明确写了怎么重开」的标记；「给后人的一句话」是每张卡都有的固定小节，不算线索
PAT = re.compile(r"(重启线|复活线|复活条件)\s*[=＝:：]\s*([^。；\n]{4,90})"
                 r"|(应另立[^。；\n]{2,70})")
rows = []
for f in files:
    t = open(f, encoding="utf-8").read()
    if fm(t, "status") != "done":
        continue
    hid = fm(t, "id")
    if hid in taken:
        continue
    leads = []
    for m in PAT.finditer(t):
        leads.append((m.group(2) or m.group(3)).strip())
    seen, uniq = set(), []
    for x in leads:
        if x not in seen:
            seen.add(x); uniq.append(x)
    if uniq:
        rows.append((hid, fm(t, "verdict"), fm(t, "cause"), uniq[:2]))

print("== 未接手的线索（来自已裁决的卡）==")
if not rows:
    print("  （没有未接手的线索）")
for hid, v, cause, leads in rows:
    print(f"\n{hid} [{v}] {cause}")
    for x in leads:
        print("    " + x)
print()
print('接手的方式：./qr claim "<新假设>" --parent <原ID> ...，这样台账里看得出族谱。')
LEADSPY
}

# 打分卡决定了做哪个课题，但从没有人回头验过它准不准。
# 只研究最高分的那个 = 分数没有变异 = 永远无法证伪自己的选题标准。
cmd_scorecard() {
  python3 - "$HYP" <<'SCPY'
import glob, os, re, sys
files = sorted(glob.glob(os.path.join(sys.argv[1], "*.md")))
def fm(t, k):
    m = re.search(r"^%s:[ \t]*(.*)$" % k, t, re.M)
    return (m.group(1).strip() if m else "")
rows = []
for f in files:
    t = open(f, encoding="utf-8").read()
    if fm(t, "status") != "done":
        continue
    sc = fm(t, "score")
    rows.append((fm(t, "id"), sc, fm(t, "verdict"), fm(t, "cause")))

def pct(sc):
    """分数写成 11/12 或 12/14；只写总分的按 14 分制处理"""
    try:
        a, _, b = sc.partition("/")
        return float(a) / (float(b) if b else 14.0)
    except ValueError:
        return None
scored = [r for r in rows if r[1]]
print(f"已裁决 {len(rows)} 张，其中记录了当初打分的 {len(scored)} 张")
if len(scored) < 8:
    print()
    print("样本不足，暂时无法回答「打分卡准不准」。")
    print("注意这不只是数量问题：如果每轮只研究最高分的候选，分数就没有变异，")
    print("再多轮也验不出预测力。所以每轮要按母提示词留一个「校准位」，")
    print("研究一个中位分候选，让打分卡有被证伪的机会。")
    if scored:
        print()
        for i, sc, v, c in scored:
            r = pct(sc)
            print(f"  {i}  {sc:>6s} = {r*100:5.1f}% → {v} {c}" if r else f"  {i}  {sc} → {v} {c}")
    raise SystemExit
buckets = {}
for i, sc, v, c in scored:
    r = pct(sc)
    if r is None: continue
    key = "高分(≥80%)" if r >= 0.80 else ("中分(55~80%)" if r >= 0.55 else "低分(<55%)")
    b = buckets.setdefault(key, {"n": 0, "PASS": 0, "PARK": 0, "FAIL": 0})
    b["n"] += 1; b[v] = b.get(v, 0) + 1
print()
print(f"{'分档':12s} {'张数':>4s} {'PASS':>5s} {'PARK':>5s} {'FAIL':>5s}")
for k in ("高分(≥80%)", "中分(55~80%)", "低分(<55%)"):
    if k in buckets:
        b = buckets[k]
        print(f"{k:12s} {b['n']:>4d} {b['PASS']:>5d} {b['PARK']:>5d} {b['FAIL']:>5d}")
print()
print("如果高分档和中分档的结局分布看不出差别，说明打分卡在做无用功，该改维度或改权重。")
SCPY
}

