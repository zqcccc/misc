      "css": ".ds-consent-primary{min-height:38px;border:1px solid var(--site-link,#075a9c);border-radius:9px;padding:0 13px;background:var(--site-link,#075a9c);color:#fff;font-size:13px;font-weight:700;white-space:nowrap;font-family:ui-sans-serif,system-ui,sans-serif}.ds-consent-primary:focus-visible{outline:3px solid color-mix(in srgb,var(--site-link,#075a9c) 76%,white);outline-offset:3px}"
