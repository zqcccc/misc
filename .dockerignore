# ==== deliverables: 只保留两个服务的 seed JSON ====
# ashare-signal 镜像 COPY ashare_strategy_backtest.json, smallcap 镜像 COPY smallcap_strategy.json
deliverables/*
!deliverables/ashare_strategy_backtest.json
!deliverables/smallcap_strategy.json

# ==== astock_quant: smallcap 镜像 COPY 整个目录, 只排研究数据/产物 ====
astock_quant/data/*
!astock_quant/data/meta.csv
astock_quant/data_bs
astock_quant/h00*
astock_quant/verified
astock_quant/reports
astock_quant/strategies_ext

# ==== monitor: 只排缓存与研究产物 ====
# 生产只引用 monitor/notifiers + webhook json (ashare-signal / smallcap 镜像 COPY)
monitor/caches
monitor/research
monitor/__pycache__

# ==== scripts: 排除研究缓存/日志, 保留全部代码 ====
# 不排除 scripts 下 TS/JS (tsconfig include **/*.ts, next build 会编译)
# scripts/trhrp_lib(含 seed/def、seed/equity 两份 seed) 与 trhrp-data 镜像所需脚本保留
scripts/_cache*
scripts/_macro_cache
scripts/_trhrp_def_cache
scripts/_ema_prices
scripts/intraday_cache
scripts/__pycache__
scripts/*.log
